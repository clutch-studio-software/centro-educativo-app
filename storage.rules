rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAuthorizedReader(userId) {
      return isOwner(userId) || (request.auth != null && request.auth.token.email != null);
    }

    // Comprobantes de pago bancario cargados por el tutor titular
    match /vouchers/{userId}/{fileName} {
      allow read: if isAuthorizedReader(userId);
      allow write: if isOwner(userId) &&
                   request.resource.size <= 2 * 1024 * 1024 &&
                   (request.resource.contentType.matches('application/pdf') ||
                    request.resource.contentType.matches('image/png') ||
                    request.resource.contentType.matches('image/jpeg'));
    }

    // Justificativos médicos de inasistencia cargados por el tutor titular
    match /justifications/{userId}/{fileName} {
      allow read: if isAuthorizedReader(userId);
      allow write: if isOwner(userId) &&
                   request.resource.size <= 2 * 1024 * 1024 &&
                   (request.resource.contentType.matches('application/pdf') ||
                    request.resource.contentType.matches('image/png') ||
                    request.resource.contentType.matches('image/jpeg'));
    }
  }
}
