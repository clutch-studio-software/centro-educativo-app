rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones auxiliares de autorización institucional
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'user_admin' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user_admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParentOf(parentId) {
      return isAuthenticated() && request.auth.uid == parentId;
    }

    // Colección users (Perfiles de padres, personal docente y administradores)
    match /users/{userId} {
      // Escritura únicamente permitida a administradores autorizados
      allow write: if isAdmin();
      
      // Lectura permitida al propio usuario dueño del documento o a un administrador
      allow read: if isOwner(userId) || isAdmin();
    }
    
    // Colección students (Datos y perfiles académicos de alumnos)
    match /students/{studentId} {
      // Creación, modificación y eliminación reservada a administradores
      allow create, update, delete: if isAdmin();
      
      // Lectura permitida al propio alumno, al padre/tutor vinculado, o a un administrador
      allow read: if isOwner(studentId) || isParentOf(resource.data.parentId) || isAdmin();
    }

    // Colección news (Noticias del portal escolar - acceso público)
    match /news/{newsId} {
      // Noticias públicas de solo lectura para visitantes del sitio web
      allow read: if request.time != null;
      
      // Publicación y edición restringida a administradores
      allow write: if isAdmin();
    }

    // Colección academicOffer (Cursos, divisiones y catálogo académico)
    match /academicOffer/{docId} {
      // Lectura para cualquier usuario institucional autenticado
      allow read: if isAuthenticated();
      
      // Modificaciones autorizadas exclusivamente a administradores
      allow write: if isAdmin();
    }
  }
}
