rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth UID
    // Fields:
    //   - role: string (required: 'user_admin', 'Directivo', 'Administrativo', 'Docente', 'Enfermeria', 'Preceptoria', 'Padre')
    //   - email: string (required)
    //   - nombre: string (optional)
    //   - dni: string (optional)
    //   - telefono: string (optional)
    //   - domicilio: string (optional)
    //   - studentIds: list of student IDs linked to parent (optional)
    //
    // Collection: students
    // Document ID: Student UID / generated ID
    // Fields:
    //   - nombre: string (required)
    //   - apellido: string (optional)
    //   - dni: string (optional)
    //   - legajo / studentID_login: string (optional)
    //   - nivel: string ('Inicial', 'Primario', 'Secundario')
    //   - curso: string (optional)
    //   - division: string (optional)
    //   - parentId: string (UID of the linked tutor/parent)
    //   - status: string (e.g. 'active', 'inactive')
    //   - entradasEnfermeria: list of medical/first aid attention records (optional)
    //   - entradasPreceptoria: list of attendance/conduct/sanction records (optional)
    //   - servicios: list of enrolled services (optional)
    //
    // Collection: news
    // Document ID: News ID
    // Fields:
    //   - title, content, date, category, image, createdAt: timestamp
    //
    // Collection: academicOffer
    // Document ID: Offer ID (e.g., 'primary', 'secondary')
    // Fields:
    //   - levels, courses, divisions, catalog
    //
    // Collection: sportsActivities
    // Document ID: Discipline ID
    // Fields:
    //   - name, category, schedule, enrolledStudents
    //
    // Collection: systemConfig
    // Document ID: Config key (e.g., 'rbac_roles')
    // Fields:
    //   - role permissions mapping, updatedAt: timestamp
    // ===============================================================

    // Helper functions for institutional authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isLinkedParent(studentId) {
      return isAuthenticated() && (
        ('parentId' in resource.data && request.auth.uid == resource.data.parentId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'studentIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds)
      );
    }

    function isParentAllowedStudentUpdate() {
      let allowedFields = [
        'servicios', 'recorridoTransporte', 'transporteFechaInicio',
        'transporteBajaSolicitada', 'transporteBajaProgramada',
        'comedor', 'comedorFechaInicio', 'comedorBajaSolicitada',
        'comedorBajaProgramada', 'observacionesComedor',
        'deportes', 'deporteFechaInicio', 'deportesSuscripciones',
        'entradasEnfermeria', 'entradasPreceptoria',
        'comprobantesPago', 'asistencias', 'updatedAt'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields) &&
        (!('parentId' in resource.data) || request.resource.data.parentId == resource.data.parentId) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
        (!('studentID_login' in resource.data) || request.resource.data.studentID_login == resource.data.studentID_login) &&
        (!('dni' in resource.data) || request.resource.data.dni == resource.data.dni) &&
        (!('nivel' in resource.data) || request.resource.data.nivel == resource.data.nivel) &&
        (!('curso' in resource.data) || request.resource.data.curso == resource.data.curso) &&
        (!('division' in resource.data) || request.resource.data.division == resource.data.division);
    }

    function isStaffRole(role) {
      return role in [
        'user_admin', 'directivo', 'Directivo', 'administrador', 'admin', 'director',
        'administrativo', 'Administrativo', 'staff', 'Staff', 'secretaria', 'secretaría',
        'docente', 'Docente', 'teacher', 'profesor', 'profesora', 'maestro',
        'enfermeria', 'Enfermeria', 'enfermería', 'Enfermería', 'salud', 'medico', 'médico',
        'preceptoria', 'Preceptoria', 'preceptoría', 'Preceptoría', 'preceptor', 'preceptora', 'celador'
      ];
    }

    function isAdminRole(role) {
      return role in [
        'user_admin', 'directivo', 'Directivo', 'administrador', 'admin', 'director'
      ];
    }

    function isStaff() {
      return isAuthenticated() && (
        isStaffRole(request.auth.token.role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         isStaffRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isAdminRole(request.auth.token.role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         isAdminRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role))
      );
    }

    // Colección users (Perfiles de padres, personal docente, salud, preceptoría y directivos)
    match /users/{userId} {
      // Escritura únicamente permitida a administradores autorizados
      allow write: if isAdmin();
      
      // Lectura permitida al propio usuario dueño del documento o a personal institucional autorizado
      allow read: if isOwner(userId) || isStaff();
    }
    
    // Colección students (Datos y perfiles académicos de alumnos)
    match /students/{studentId} {
      // Creación y eliminación reservada a administradores autorizados
      allow create, delete: if isAdmin();

      // Modificación permitida a administradores/personal institucional o padres vinculados en campos permitidos
      allow update: if isStaff() || (isLinkedParent(studentId) && isParentAllowedStudentUpdate());
      
      // Lectura permitida al propio alumno, al padre/tutor vinculado, o al personal institucional autorizado
      allow read: if isOwner(studentId) || isLinkedParent(studentId) || isStaff();
    }

    // Colección news (Noticias del portal escolar - acceso público)
    match /news/{newsId} {
      // Noticias públicas de solo lectura para visitantes del sitio web
      allow read: if request.time != null;
      
      // Publicación y edición restringida a administradores
      allow write: if isAdmin();
    }

    // Colección academicOffer (Cursos, divisiones y catálogo académico)
    match /academicOffer/{docId} {
      // Lectura para cualquier usuario institucional autenticado
      allow read: if isAuthenticated();
      
      // Modificaciones autorizadas exclusivamente a administradores
      allow write: if isAdmin();
    }

    // Colección sportsActivities (Disciplinas deportivas y actividades extracurriculares)
    match /sportsActivities/{docId} {
      // Lectura para cualquier usuario institucional autenticado
      allow read: if isAuthenticated();
      
      // Creación y actualización permitida a personal, administradores o usuarios autenticados (inscripciones)
      allow create, update: if isStaff() || isAdmin() || isAuthenticated();
      allow delete: if isAdmin();
    }

    // Colección tariffs_config (Configuración centralizada de aranceles y tarifas)
    match /tariffs_config/{docId} {
      // Lectura para cualquier usuario autenticado o personal institucional
      allow read: if isAuthenticated();
      
      // Modificaciones autorizadas a personal institucional o administradores
      allow write: if isStaff() || isAdmin();
    }

    // Colección tariff_audit_logs (Trazabilidad y auditoría de cambios de precios)
    match /tariff_audit_logs/{auditId} {
      // Lectura y creación permitida a personal institucional o administradores
      allow read: if isStaff() || isAdmin();
      allow create: if isStaff() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Colección finance_receipts (Gestión institucional de comprobantes y recibos de aranceles)
    match /finance_receipts/{receiptId} {
      // Lectura para cualquier usuario autenticado o personal institucional
      allow read: if isAuthenticated();

      // Creación para usuarios autenticados (tutores al subir comprobante o personal)
      allow create: if isAuthenticated();

      // Conciliación, aprobación y rechazo por personal institucional o administradores, o actualización por el tutor al adjuntar comprobantes
      allow update: if isStaff() || isAdmin() || isAuthenticated();

      // Eliminación únicamente por administradores o personal institucional
      allow delete: if isAdmin() || isStaff();
    }

    // Colección systemConfig (Configuraciones del sistema y matriz de roles/permisos RBAC)
    match /systemConfig/{docId} {
      // Lectura permitida si el usuario es staff o administrador institucional
      allow read: if isStaff() || isAdmin();

      // Escritura permitida exclusivamente si el usuario es administrador
      allow write: if isAdmin();
    }
  }
}
