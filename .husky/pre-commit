#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

BLUE="\033[1;34m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
RED="\033[1;31m"
RESET="\033[0m"

run_step() {
  local step_name="$1"
  local cmd="$2"
  local log_file
  log_file=$(mktemp)
  local spin_chars=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

  eval "$cmd" > "$log_file" 2>&1 &
  local pid=$!

  # Ocultar cursor mientras corre el spinner si es terminal interactiva
  tput civis 2>/dev/null || true

  local i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r${BLUE}[INFO]${RESET} %s: ${CYAN}%s${RESET} " "$step_name" "${spin_chars[i]}"
    i=$(( (i + 1) % ${#spin_chars[@]} ))
    sleep 0.08
  done

  # Restaurar cursor
  tput cnorm 2>/dev/null || true

  wait "$pid"
  local exit_code=$?

  if [[ $exit_code -eq 0 ]]; then
    printf "\r${BLUE}[INFO]${RESET} %s: ${GREEN}✔${RESET}\033[K\n" "$step_name"
    rm -f "$log_file"
    return 0
  else
    printf "\r${BLUE}[INFO]${RESET} %s: ${RED}✖${RESET}\033[K\n" "$step_name"
    echo ""
    echo -e "${RED}══════════ Falló la verificación: $step_name ══════════${RESET}"
    cat "$log_file"
    echo -e "${RED}═══════════════════════════════════════════════════════${RESET}"
    echo ""
    rm -f "$log_file"
    return $exit_code
  fi
}

echo -e "\n${BLUE}🔍 Ejecutando suite de validación Pre-commit...${RESET}"

# 1. ESLint
run_step "Running ESLint" "npm run lint" || exit 1

# 2. React Doctor
run_step "Running React-Doctor" "echo '' | npx --yes react-doctor@latest --blocking error" || exit 1

# 3. SonarQube / jscpd Duplication Check
run_step "Running Duplication Check" "npm run check:duplicates" || exit 1

echo "${GREEN}✔ Todas las validaciones de calidad pasaron exitosamente.${RESET}\n"
